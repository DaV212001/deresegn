<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base configuration: Only trust system CAs, never user-installed CAs (e.g., Burp Suite proxy CA) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Domain configuration for Deresegn API with certificate pinning -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.deresegn.com</domain>
        <domain includeSubdomains="true">deresegn.com</domain>
        <pin-set expiration="2027-12-31">
            <!-- api.deresegn.com Leaf Certificate SHA-256 pin -->
            <pin digest="SHA-256">q8fdcWcvnDiisKfrHURRCALtX0Y0JaqJIylUlWCzuGU=</pin>
            <!-- Let's Encrypt Intermediate CA (YR1) SHA-256 pin -->
            <pin digest="SHA-256">E5SWNNmc1v1qqAvANP76zOsZaf7vmGWGcT7NuwV1jT8=</pin>
            <!-- ISRG Root X1 SHA-256 pin -->
            <pin digest="SHA-256">lrzsBiZJdvN0YHeazyjFp8/oo8Cq4RqP/O4FwL3fCMY=</pin>
        </pin-set>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
